# ==========================================
# GitHub / Medium ADK 101 Project .gitignore
# ==========================================

# --- Python Environment & Virtual Environments ---
.venv/
venv/
ENV/
env/
pyvenv.cfg
.Python
build/
dist/
*.egg-info/
.eggs/
eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/

# --- Python Bytecode & Cache ---
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.tox/
.coverage
.cache

# --- Google ADK & Application Runtime Logs ---
.adk/
*.log
adk_run*.json
.agents_state/
.mcp_cache/

# --- Secrets & Environment Configurations (MANDATORY TO IGNORE) ---
.env
.env.local
.env.*
.secrets
*.pem
*.key
google-creds.json
.gcp-credentials.json

# --- IDEs and Editor Specific ---
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db